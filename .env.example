# Shared configuration template. Copy to .env and replace placeholders.
# Do not copy production credentials, account IDs or private hostnames here.
# Retired local-login, email-verification and password-reset settings are omitted.

# Database used when running services directly on the host.
# Docker Compose constructs its internal URL from POSTGRES_* below.
DATABASE_URL='postgresql+asyncpg://construction_app:change-me@127.0.0.1/construction_hazard_detection'
# Docker Compose credentials.  Set non-placeholder values before `docker compose up`.
POSTGRES_DB='construction_hazard_detection'
POSTGRES_USER='construction_app'
POSTGRES_PASSWORD='replace-with-a-strong-password'
# Connection budget shared by all Uvicorn worker processes.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
# Production schema is managed through the private deployment process. Enable
# this only for throw-away local databases created from ORM metadata.
AUTO_CREATE_SCHEMA=false


# API URLs
DETECT_API_URL = "http://127.0.0.1:8000"
# Authenticated binary model synchronisation.  The bearer token must belong to
# a non-guest account permitted to call /get_new_model.
MODEL_FETCH_API_URL = "http://127.0.0.1:8000/get_new_model"
MODEL_FETCH_BEARER_TOKEN = ""
MODEL_FETCH_MAX_BYTES = 6442450944
# Apply ingress limits before bytes are handed to the inference semaphore.
DETECT_MAX_UPLOAD_BYTES = 20971520
DETECT_INGRESS_CONCURRENCY = 8
MODEL_UPLOAD_MAX_BYTES = 6442450944
DETECT_SERVER_MODEL_KEYS = yolo26n,yolo26s,yolo26m,yolo26l,yolo26x
YOLO_WS_ALLOW_LOCALHOST_BYPASS = true
# OpenCV timeouts are milliseconds; reconnect delays are seconds.
STREAM_CAPTURE_OPEN_TIMEOUT_MS=5000
STREAM_CAPTURE_READ_TIMEOUT_MS=5000
STREAM_CAPTURE_REOPEN_DELAY_SECONDS=5
STREAM_CAPTURE_MAX_REOPEN_DELAY_SECONDS=60
# Primary RTSP liveness comes from OpenCV read/open timeouts. When OpenCV
# exposes a positive source PTS, reconnect only if that timestamp stops
# advancing. A static construction scene therefore remains healthy.
STREAM_CAPTURE_TIMESTAMP_RECONNECT_SECONDS = 45
STREAM_CAPTURE_TIMESTAMP_SAMPLE_SECONDS = 1
# When RTSP does not expose source PTS, exact or near-identical decoded frames
# provide the fallback liveness signal. Sources with advancing PTS bypass this
# visual check, so a healthy static scene is not reconnected unnecessarily.
STREAM_CAPTURE_FREEZE_RECONNECT_SECONDS = 15
STREAM_CAPTURE_FREEZE_SAMPLE_SECONDS = 1
STREAM_CAPTURE_FREEZE_FRAME_DELTA = 0.2
# Default for model keys not listed below. A TensorRT worker/engine only serves
# cameras with the same model key.
YOLO_WORKER_CAMERAS_PER_ENGINE = 3
# Override the per-engine camera count by model size. Format:
# model_key=camera_count,model_key=camera_count
YOLO_WORKER_CAMERAS_PER_ENGINE_BY_MODEL = yolo26n=8,yolo26s=6,yolo26m=4,yolo26l=2,yolo26x=1
YOLO_WORKER_DEVICES = cuda:0,cuda:0
YOLO_WORKER_QUEUE_SIZE = 64
# Native per-camera response queues avoid Manager proxy overhead.
YOLO_WORKER_RESULT_QUEUE_SIZE = 8
# Persistent per-camera shared-memory slots. Increase only when a camera has
# multiple in-flight requests; each slot reserves one source-resolution frame.
YOLO_WORKER_RING_SLOTS = 2
YOLO_WORKER_RING_SLOT_CLEANUP_SECONDS = 120
YOLO_WORKER_TIMEOUT_SECONDS = 30
YOLO_WORKER_BATCH_SIZE = 8
YOLO_WORKER_BATCH_WAIT_MS = 10
YOLO_WORKER_PRECISION = f16
YOLO_WORKER_DEVICE = cuda:0
YOLO_WORKER_IMGSZ = 640
# Zero disables periodic inference metrics.
YOLO_WORKER_METRICS_INTERVAL_SECONDS=0
# YOLO_WORKER_PRECISION accepts: f32, f16, int8
# f32/f16 use models/pt/*.pt; int8 uses models/int8_engine/*.engine.
# Legacy advanced overrides are ignored when YOLO_WORKER_PRECISION is set:
# YOLO_WORKER_MODEL_DIR = models/pt
# YOLO_WORKER_MODEL_SUFFIX = .pt
# YOLO_WORKER_HALF = true
# YOLO_WORKER_QUANTIZE = 16
FCM_API_URL = "http://127.0.0.1:8003"
VIOLATION_RECORD_API_URL = "http://127.0.0.1:8002"
STREAMING_OVERLAY_PARSE_CACHE_SIZE = 256
STREAMING_OVERLAY_MAX_LABELS = 40
STREAMING_OVERLAY_DRAW_LABELS = true
STREAMING_OVERLAY_LABEL_WARNINGS_ONLY = false
STREAMING_OVERLAY_DRAW_WARNING_SUMMARY = true
STREAMING_OVERLAY_DRAW_WARNING_STATUS=false
STREAMING_OVERLAY_MAX_WARNING_SUMMARY_ITEMS = 5
STREAMING_OVERLAY_TEXT_BITMAP_CACHE_SIZE = 4096

# Media server streaming
STREAMING_OUTPUT_MODE = "media_server"
MEDIA_PUBLISH_RTSP_BASE_URL = "rtsp://media-server:8554"
MEDIA_PUBLISH_CLEAN_STREAM = true
# Encode the detail clean path from the shared latest-frame capture. This
# prevents an extra RTSP connection per camera, discards stale frames, and
# produces a predictable HLS keyframe cadence. Enable source restreaming only
# when an untouched camera bitstream is explicitly required.
MEDIA_PUBLISH_CLEAN_SOURCE_RESTREAM = false
MEDIA_PUBLISH_CLEAN_ENCODER = "h264_vaapi"
MEDIA_PUBLISH_CLEAN_FPS = 15
MEDIA_PUBLISH_ANNOTATED_STREAM = true
MEDIA_PUBLISH_SOURCE_FPS = 15
MEDIA_PUBLISH_RTP_PACKET_SIZE = 1200
MEDIA_DEFAULT_OVERLAY_LANGUAGE = "zh-TW"
MEDIA_OVERLAY_ALLOWED_LANGUAGES = "zh-TW,en,zh-CN,ja,vi,id,fr,th"
MEDIA_OVERLAY_MAX_ACTIVE_LANGUAGES_PER_STREAM = 5
MEDIA_OVERLAY_DEMAND_TTL_SECONDS = 90
# Redis demand is shared by all publishers for one camera during this interval.
MEDIA_DEMAND_CACHE_SECONDS = 0.5
MEDIA_OVERLAY_READY_TTL_SECONDS = 15
MEDIA_PUBLISHER_IDLE_GRACE_SECONDS = 180
MEDIA_PUBLISH_OVERLAY_MIN_CONFIDENCE = 0.25
# Detail overlays and low-bitrate previews use the Intel iGPU. VAAPI does not
# consume the GeForce NVENC session quota. The host user needs membership in
# the `render` group and this path must be available inside Docker as well.
MEDIA_PUBLISH_ENCODER = "h264_vaapi"
MEDIA_PUBLISH_VAAPI_DEVICE = "auto"
MEDIA_PUBLISH_VAAPI_RC_MODE = "CBR"
MEDIA_PUBLISH_VAAPI_BITRATE = "4M"
MEDIA_PUBLISH_VAAPI_MAXRATE = "8M"
MEDIA_PUBLISH_VAAPI_BUFSIZE = "16M"
MEDIA_PUBLISH_VAAPI_ASYNC_DEPTH = 1
MEDIA_PUBLISH_FPS = 15
MEDIA_PUBLISH_KEYFRAME_INTERVAL_SECONDS=2
MEDIA_PUBLISH_CRF = 28
MEDIA_PUBLISH_PRESET = "veryfast"
MEDIA_PREVIEW_WIDTH = 640
MEDIA_PREVIEW_HEIGHT = 360
MEDIA_PREVIEW_FPS = 15
MEDIA_PREVIEW_BITRATE = "500k"
MEDIA_PREVIEW_MAXRATE = "700k"
MEDIA_PREVIEW_BUFSIZE = "1400k"
MEDIA_PUBLIC_HLS_BASE_URL = "/hazard/media"
MEDIA_PUBLIC_WEBRTC_BASE_URL = "/hazard/media/webrtc"
# streaming_web 讀取 MediaMTX playlist 的內部位址。
# Docker Compose 使用 http://media-server:8888；host 上直接跑 uvicorn 可用 http://127.0.0.1:8890。
MEDIA_INTERNAL_HLS_BASE_URL = "http://media-server:8888"

# MediaMTX HLS settings consumed by both Docker Compose definitions.
MTX_HLSALWAYSREMUX=no
MTX_HLSVARIANT=lowLatency
MTX_HLSSEGMENTDURATION=2s
MTX_HLSSEGMENTCOUNT=14
MTX_HLSPARTDURATION=200ms
MTX_HLSMUXERCLOSEAFTER=60s

# Redis
REDIS_HOST = '127.0.0.1'
REDIS_PORT = 6379
REDIS_PASSWORD = 'replace-with-a-strong-password'

# Firebase
FIREBASE_CRED_PATH = 'examples/local_notification_server/your-firebase-adminsdk.json'
FIREBASE_PROJECT_ID = 'your-project-id'
# Optional social notification channels: uv sync --extra social-notifications.
LINE_CHANNEL_ACCESS_TOKEN=''
# Cloudinary is used only for LINE image uploads.
CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''
TELEGRAM_BOT_TOKEN=''
FACEBOOK_PAGE_ACCESS_TOKEN=''
WECHAT_CORP_ID=''
WECHAT_CORP_SECRET=''
WECHAT_AGENT_ID=0
BROADCAST_URL='http://localhost:8080/broadcast'

# Self-hosted Keycloak uses a separate database on the existing PostgreSQL
# server. It must not use the Visionnaire application database or tables.
KEYCLOAK_ADMIN_USERNAME='keycloak-admin'
KEYCLOAK_ADMIN_PASSWORD='replace-with-a-unique-admin-password'
KEYCLOAK_DB_USERNAME='your-postgres-role'
KEYCLOAK_DB_PASSWORD='replace-with-the-postgres-role-password'
KEYCLOAK_USER_LINKER_CLIENT_SECRET='replace-with-a-unique-linker-secret'
KEYCLOAK_USER_LINKER_CLIENT_ID='visionnaire-user-linker'
# Backend-only native social assertion exchange. Generate a distinct random
# value of at least 32 characters; never place this in Flutter or a Keycloak
# realm export. The default client entry matches deploy/keycloak/start.sh.
NATIVE_SOCIAL_EXCHANGE_ENABLED=false
NATIVE_SOCIAL_EXCHANGE_SHARED_SECRET=''
NATIVE_SOCIAL_ALLOWED_CLIENTS_JSON='{"visionnaire-mobile":["com.example.visionnaire:/oauthredirect"]}'
NATIVE_SOCIAL_EXCHANGE_TTL_SECONDS=90
NATIVE_SOCIAL_LINK_TTL_SECONDS=120
NATIVE_SOCIAL_LINK_MAX_AUTH_AGE_SECONDS=300
KEYCLOAK_REALM='visionnaire'
# Leave empty to derive the public base from OIDC_ISSUER_URL. A local-only
# value avoids a public round trip for Keycloak Admin identity-link requests.
KEYCLOAK_ADMIN_BASE_URL='http://127.0.0.1:8081/keycloak'
# Keycloak identity-brokered social sign-in for the Web BFF. Visionnaire never
# receives these third-party *client secrets*. Native app assertions use the
# nonce-bound exchange above and are verified only by the backend.
# Create a dedicated Google *Web application* OAuth client with Keycloak's
# broker endpoint as its only redirect URI; do not reuse the mobile client IDs.
KEYCLOAK_GOOGLE_ENABLED=false
KEYCLOAK_GOOGLE_CLIENT_ID=''
KEYCLOAK_GOOGLE_CLIENT_SECRET=''
# Apple uses the existing Services ID, but the client secret must be a signed
# JWT renewed before expiry. Generate it with scripts/generate_apple_client_secret.py.
KEYCLOAK_APPLE_ENABLED=false
KEYCLOAK_APPLE_CLIENT_ID='com.example.visionnaire.signin'
KEYCLOAK_APPLE_CLIENT_SECRET=''
# OIDC is the only supported login flow. Provision users and identity links
# before deployment; all API services must receive the same OIDC_* values.
OIDC_ENABLED=true
OIDC_ISSUER_URL='https://sso.example.com/realms/visionnaire'
OIDC_JWKS_URL='https://sso.example.com/realms/visionnaire/protocol/openid-connect/certs'
OIDC_AUDIENCE='visionnaire-api'
OIDC_IDENTITY_PROVIDER='keycloak'
OIDC_JWT_ALGORITHMS='RS256'
OIDC_JWKS_CACHE_SECONDS=300
OIDC_JWKS_TIMEOUT_SECONDS=5
# Confidential Visionnaire BFF client. Register this exact callback in
# Keycloak and keep the client secret only in the server secret store.
OIDC_WEB_CLIENT_ID='visionnaire-web'
OIDC_WEB_CLIENT_SECRET='replace-with-keycloak-client-secret'
OIDC_WEB_AUTHORIZATION_ENDPOINT='https://sso.example.com/realms/visionnaire/protocol/openid-connect/auth'
OIDC_WEB_TOKEN_ENDPOINT='https://sso.example.com/realms/visionnaire/protocol/openid-connect/token'
OIDC_WEB_REDIRECT_URI='https://app.example.com/bff/auth/oidc/callback'
# Server-only RP-initiated logout settings. The BFF returns a one-use local
# redirect URL; the browser must navigate to it rather than handle tokens.
OIDC_WEB_END_SESSION_ENDPOINT='https://sso.example.com/realms/visionnaire/protocol/openid-connect/logout'
OIDC_WEB_POST_LOGOUT_REDIRECT_URI='https://app.example.com/'
OIDC_STATE_TTL_SECONDS=300
# Users manage their password through the identity-provider account console.
OIDC_ACCOUNT_URL='https://sso.example.com/realms/visionnaire/account'
FCM_TOKEN_ENCRYPTION_KEY='replace-with-a-fernet-key'
HCAPTCHA_SECRET_KEY='replace-with-hcaptcha-secret'
HCAPTCHA_SITE_KEY='replace-with-hcaptcha-site-key'
# Full BFF (Flutter Web)
BFF_TOKEN_ENCRYPTION_KEY='replace-with-an-independent-32-byte-secret'
BFF_SESSION_COOKIE_NAME='__Host-vn_session'
BFF_SESSION_COOKIE_SECURE=true
# Keep the browser BFF cookie aligned with Keycloak's online SSO maximum.
# The browser flow intentionally does not use offline_access tokens.
BFF_SESSION_TTL_SECONDS=36000
BFF_REFRESH_BEFORE_SECONDS=30
BFF_UPSTREAM_TIMEOUT_SECONDS=20
BFF_CHAT_API_URL='http://127.0.0.1:8001'
BFF_FILES_API_URL='http://127.0.0.1:8004'
BFF_DETECTION_API_URL='http://127.0.0.1:8000'
BFF_MANAGEMENT_API_URL='http://127.0.0.1:8005'
BFF_FCM_API_URL='http://127.0.0.1:8003'
BFF_VIOLATIONS_API_URL='http://127.0.0.1:8002'
BFF_STREAMING_API_URL='http://127.0.0.1:8800'
# Docker Compose should override this to http://streaming-web-backend:8000.
PLAYBACK_STREAMING_API_URL='http://127.0.0.1:8800'
# WebRTC ICE: STUN is required. Configure TURN variables only when using TURN.
STREAMING_WEBRTC_STUN_URLS='stun:stun.l.google.com:19302'
# Optional TURN: uncomment all three settings together. An empty TURN_URLS
# value is invalid; leave the variable unset for a STUN-only deployment.
# STREAMING_WEBRTC_TURN_URLS='turn:turn.example.com:3478?transport=udp'
# STREAMING_WEBRTC_TURN_SHARED_SECRET='replace-with-turn-shared-secret'
# STREAMING_WEBRTC_TURN_TTL_SECONDS=600

# Independent HLS media capability (5-15 minutes)
MEDIA_SESSION_TTL_SECONDS=600
CORS_ALLOWED_ORIGINS='https://app.example.com,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080'
# Public API root used by native deployment discovery.  It must include the
# API prefix, but never /db_management, /fcm, or another individual service.
DEPLOYMENT_API_BASE_PATH='/hazard/api'
# Disabled in production.  When enabled, only a direct loopback request to
# 127.0.0.1/localhost can use this fixed server-side deployment mapping.
LOCAL_DEVELOPMENT_AUTH_ENABLED=false
LOCAL_DEVELOPMENT_DEPLOYMENT_ID=''
# Inject the real PEM only through the backend Secret Store/KMS integration;
# never commit it or place it in a Flutter application.
DEPLOYMENT_REGISTRY_ED25519_PRIVATE_KEY=''
DEPLOYMENT_REGISTRY_KEY_ID='registry-ed25519-2026-01'
# Must be positive and no more than 86400 (24 hours).
DEPLOYMENT_REGISTRY_TTL_SECONDS=86400
# Inject a high-entropy value through Secret Manager/KMS.  It HMACs one-time
# enrollment codes before storage and must never be committed or sent to apps.
DEPLOYMENT_ENROLLMENT_CODE_PEPPER=''
# Each limit applies independently to a requesting IP and code verifier.
DEPLOYMENT_ENROLLMENT_RATE_LIMIT_MAX=5
DEPLOYMENT_ENROLLMENT_RATE_LIMIT_WINDOW_SECONDS=300
# Social login: use your registered client IDs and keep redirect URIs aligned
# with Keycloak, the native app and NATIVE_SOCIAL_ALLOWED_CLIENTS_JSON.
GOOGLE_WEB_CLIENT_ID='your-web-client-id.apps.googleusercontent.com'
GOOGLE_IOS_CLIENT_ID='your-ios-client-id.apps.googleusercontent.com'
GOOGLE_ANDROID_CLIENT_ID='your-android-client-id.apps.googleusercontent.com'
APPLE_TEAM_ID='YOURTEAMID'
APPLE_KEY_ID='YOURKEYID'
APPLE_SERVICE_ID='com.example.visionnaire.signin'
APPLE_BUNDLE_ID='com.example.visionnaire'
APPLE_REDIRECT_URI='https://app.example.com/hazard/api/db_management/auth/apple/callback'
APPLE_PRIVATE_KEY_PATH='config/secrets/apple/AuthKey_YOURKEYID.p8'

# Model keys are published in detection_model_catalog (database).
# HF_TOKEN may be configured for private Hugging Face repositories.
# HF_HOME can point to a persistent model download cache.

# Log violation detail/options JSON: * for all, comma-separated IDs, or empty.
VIOLATION_DEBUG_RESPONSE_IDS=

# Background detection workers use the OIDC client-credentials grant.
# Use a dedicated confidential Keycloak client with service accounts enabled.
WORKER_OIDC_CLIENT_ID=''
WORKER_OIDC_CLIENT_SECRET=''
# Empty derives /protocol/openid-connect/token from OIDC_ISSUER_URL.
WORKER_OIDC_TOKEN_ENDPOINT=''

# Optional MCP server: install with uv sync --extra mcp.
# stdio is suitable for a trusted local AI client; HTTP binds to loopback by default.
MCP_TRANSPORT='streamable-http'
MCP_HOST='127.0.0.1'
MCP_PORT=8092
MCP_PATH='/mcp'
MCP_SSE_PATH='/sse'
MCP_DEBUG=false
MCP_UPSTREAM_TIMEOUT_SECONDS=20
MCP_REMOTE_IMAGE_TIMEOUT_SECONDS=20
MCP_MAX_REMOTE_IMAGE_BYTES=10485760
# Optional existing OIDC access token for queries only; uploads/FCM use WORKER_OIDC_*.
MCP_STATIC_BEARER=''
