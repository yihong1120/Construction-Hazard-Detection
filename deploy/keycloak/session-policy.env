# Generated by python -m deploy.keycloak.session_policy; edit src/settings/session_policy.json.
SSO_SESSION_IDLE_SECONDS=604800
SSO_SESSION_MAX_SECONDS=7776000
ACCESS_TOKEN_SECONDS=300
DEFAULT_CLIENT_IDLE_SECONDS=28800
DEFAULT_CLIENT_MAX_SECONDS=36000
SESSION_POLICY_CLIENTS=(visionnaire-web visionnaire-web-dev visionnaire-mobile)
SESSION_POLICY_OPTIONAL_CLIENTS=(visionnaire-web-dev)
declare -A SESSION_POLICY_REALM=(
    [ssoSessionIdleTimeout]=604800
    [ssoSessionMaxLifespan]=7776000
    [accessTokenLifespan]=300
    [clientSessionIdleTimeout]=28800
    [clientSessionMaxLifespan]=36000
)
declare -A SESSION_POLICY_ATTRIBUTES=(
    [client.session.idle.timeout]=604800
    [client.session.max.lifespan]=7776000
    [access.token.lifespan]=300
)
