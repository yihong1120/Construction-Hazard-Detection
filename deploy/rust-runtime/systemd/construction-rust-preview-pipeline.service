[Unit]
Description=Construction Rust camera pipeline preview
After=network.target construction-rust-preview-api.service

[Service]
Type=exec
User=chd-rust-preview-pipeline
Group=chd-rust-preview-pipeline
EnvironmentFile=/etc/construction-rust-preview/pipeline.env
ExecStart=/opt/construction-rust-preview/current/bin/construction-pipeline run --config /etc/construction-rust-preview/pipeline.json
StateDirectory=construction-rust-preview-pipeline
StateDirectoryMode=0700
WorkingDirectory=/var/lib/construction-rust-preview-pipeline
Restart=on-failure
RestartSec=3s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
